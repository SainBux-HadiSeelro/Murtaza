# ── Supabase Configuration ───────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Cloudinary Configuration ─────────────────────────────────────────────────
# Get these from Cloudinary Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Access Passwords ──────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_admin_password
NEXT_PUBLIC_SLIDESHOW_PASSWORD=your_secure_slideshow_password

# ── App URL (Used for QR code generation) ────────────────────────────────────
# Local: http://localhost:3000
# Production: https://sainbux.online
NEXT_PUBLIC_APP_URL=http://localhost:3000
