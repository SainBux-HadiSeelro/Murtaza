rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{photoId} {
      // Anyone can upload photos (guests)
      allow write: if
        request.resource.size < 10 * 1024 * 1024 &&  // max 10MB
        request.resource.contentType.matches('image/.*');

      // Anyone can read photos (slideshow + admin)
      allow read: if true;
    }
  }
}
